# 本地环境
ENV = 'development'
# 本地环境接口地址
VITE_API_URL = 'http://localhost:8888/'

# 方案B：前端直连后端，不走 /api /flask 代理
VITE_SPRING_ORIGIN = http://47.108.20.251:9999
VITE_FLASK_ORIGIN = http://47.108.20.251:5000

# Flask 代理与 Socket（当前后端：47.108.20.251:5000）
VITE_PROXY_FLASK_TARGET = http://47.108.20.251:5000/
VITE_SOCKET_URL = http://47.108.20.251:5000

# 可选：Spring 网关，留空则使用 vite.config 内默认 springboot.jiutian.icu
# VITE_PROXY_API_TARGET = http://springboot.jiutian.icu/

# 可选：文件上传直链域名；不设则使用 /api/files/upload 走代理
# VITE_STATIC_FILE_ORIGIN = http://springboot.jiutian.icu