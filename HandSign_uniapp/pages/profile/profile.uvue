  background:rgba(255,255,255,0.85);
  backdrop-filter:blur(20rpx);
  border-radius:30rpx;
  padding:40rpx;
  margin-bottom:30rpx;
  box-shadow:0 20rpx 60rpx rgba(0,0,0,0.1);
  opacity:0.9; /* 整体卡片透明度 */
}

.card-header{display:flex;align-items:center;margin-bottom:40rpx}
.card-icon{
  font-size:32rpx;
  margin-right:15rpx;
  opacity:0.9; /* 卡片图标透明度 */
}
.card-title{
  font-size:34rpx;
  font-weight:bold;
  color:#333;
  opacity:0.95; /* 卡片标题透明度 */
}
.info-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:30rpx}
.info-item{
  display:flex;
  justify-content:space-between;
  align-items:center;
  padding:20rpx 0;
  border-bottom:2rpx solid #f5f5f5;
  opacity:0.95; /* 信息项透明度 */
}
.info-item:nth-last-child(-n+2){border-bottom:none}
