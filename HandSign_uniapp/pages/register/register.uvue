<template>
  <view class="register-page">
    <view class="bg-layer">
      <image class="bg-img" src="" mode="scaleToFill"></image>
      <view class="mask"></view>
    </view>

    <view class="content-wrapper">
      <view class="title-box">
        <text class="main-title">手语识别系统 - 用户注册</text>
        <text class="sub-title">Sign Language Recognition</text>
      </view>

      <view class="register-container">
        <view class="form-item">
          <view class="input-wrapper" :class="{ 'error-border': usernameError }">
            <text class="input-icon">👤</text>
            <input 
              v-model="username" 
              type="text" 
              placeholder="请输入用户名" 
              class="input-box"
              @input="clearUsernameError"
            />
          </view>
          <text v-if="usernameError" class="error-text">{{ usernameError }}</text>
        </view>
        
        <view class="form-item">
          <view class="input-wrapper" :class="{ 'error-border': pwdError && password.value }">
            <text class="input-icon">🔒</text>
            <input 
              v-model="password" 
              type="password" 
              placeholder="请输入密码（不少于6位）" 
              class="input-box"
              @input="clearPwdError"
            />
          </view>
          <text v-if="pwdError" class="error-text">{{ pwdError }}</text>
        </view>
        
        <view class="form-item">
          <view class="input-wrapper" :class="{ 'error-border': pwdError && confirmPwd.value && password.value !== confirmPwd.value }">
            <text class="input-icon">🔐</text>
            <input 
              v-model="confirmPwd" 
              type="password" 
              placeholder="请确认密码" 
              class="input-box"
              @input="clearPwdError"
            />
          </view>
        </view>
        
        <view class="form-item">
          <view class="input-wrapper captcha-wrapper" :class="{ 'error-border': captchaError }">
            <text class="input-icon">🔢</text>
            <input 
              v-model="captchaAnswer" 
              type="number" 
              placeholder="请输入验证码答案" 
              class="input-box captcha-input"
              @input="clearCaptchaError"
            />
            <image :src="captchaUrl" @click="refreshCaptcha" class="captcha-img" mode="widthFix"></image>
            <text @click="refreshCaptcha" class="refresh-icon">🔄</text>
          </view>
          <text v-if="captchaError" class="error-text">{{ captchaError }}</text>
        </view>
        
        <button 
          class="register-btn" 
          @click="handleRegister"
          :disabled="isLoading"
        >
          {{ isLoading ? '注册中...' : '注册' }}
        </button>
        
        <view class="link-box">
          <text @click="goLogin" class="login-link">已有账号？去登录</text>
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
import { ref, onMounted } from 'vue';
import { userRegister, type RegisterParams } from '@/api/register.uts';
import { getCaptcha, checkCaptcha, type CaptchaGetResult } from '@/api/captcha.uts';
import type { ApiResult } from '@/common/request.uts';

const username = ref('');
const password = ref('');
const confirmPwd = ref('');
const isLoading = ref(false);
const usernameError = ref('');
const pwdError = ref('');
const captchaAnswer = ref('');
const captchaUrl = ref('');
const captchaError = ref('');
const captchaToken = ref('');

const clearUsernameError = () => {
  usernameError.value = '';
};

const clearPwdError = () => {
  pwdError.value = '';
};

const clearCaptchaError = () => {
  captchaError.value = '';
};

onMounted(() => refreshCaptcha());

const refreshCaptcha = async () => {
  try {
    const res = await getCaptcha() as ApiResult<CaptchaGetResult>;
    captchaUrl.value = res.data.captchaImage;
    captchaToken.value = res.data.captchaToken;
    captchaAnswer.value = '';
    captchaError.value = '';
  } catch (err) {
    uni.showToast({ title: '验证码加载失败', icon: 'none' });
  }
};

const handleRegister = async () => {
  if (!username.value) {
    usernameError.value = '请输入用户名';
    return;
  }
  if (!password.value) {
    pwdError.value = '请输入密码';
    return;
  }
  if (password.value.length < 6) {
    pwdError.value = '密码长度不能少于6位';
    return;
  }
  if (password.value !== confirmPwd.value) {
    pwdError.value = '两次输入的密码不一致';
    return;
  }
  if (!captchaAnswer.value) {
    captchaError.value = '请输入验证码';
    return;
  }
  if (!captchaToken.value) {
    captchaError.value = '请刷新验证码';
    return;
  }

  try {
    const captchaRes = await checkCaptcha({ 
      captchaToken: captchaToken.value,
      userAnswer: captchaAnswer.value 
    }) as ApiResult<any>;
  } catch (err: any) {
    captchaError.value = err.msg || '验证码错误';
    refreshCaptcha();
    return;
  }

  const registerParams: RegisterParams = {
    username: username.value,
    password: password.value
  };

  isLoading.value = true;
  try {
    await userRegister(registerParams);
    
    uni.showToast({ 
      title: '注册成功！即将跳转到登录页', 
      icon: 'success',
      duration: 2000 
    });
    
    setTimeout(() => {
      uni.navigateBack({
        delta: 1,
        fail: () => {
          uni.redirectTo({ url: '/pages/login/login' });
        }
      });
    }, 2000);

  } catch (err: any) {
    if (err.msg) {
      usernameError.value = err.msg;
    } else {
      uni.showToast({ title: '注册失败，请稍后重试', icon: 'none' });
    }
    console.error('注册失败：', err);
  } finally {
    isLoading.value = false;
  }
};

const goLogin = () => {
  uni.navigateBack({
    delta: 1,
    fail: () => {
      uni.redirectTo({ url: '/pages/login/login' });
    }
  });
};
</script>

<style scoped>
