<template>
  <view class="page-container">
    <view class="search-bar">
      <view class="search-box" v-if="userRole == 'admin'">
        <text class="icon-search">🔍</text>
        <input
          v-model="searchKeyword"
          class="search-input"
          placeholder="搜索用户名"
          @input="handleSearch"
        ></input>
        <view class="search-clear" @click="searchKeyword=''" v-if="searchKeyword">×</view>
      </view>
    </view>

    <view class="loading-wrap" v-if="loading">
      <view class="loading-spinner"></view>
      <text class="loading-text">加载中...</text>
    </view>

    <scroll-view class="list-scroll" scroll-y="true" v-else>
      <view class="empty-wrap" v-if="filteredList.length === 0">
        <text class="empty-icon">📷</text>
        <text class="empty-text">{{ searchKeyword ? '未搜索到相关记录' : '暂无数据' }}</text>
      </view>

      <view class="grid-container">
        <view class="grid-item" v-for="item in currentPageData" :key="item.id">
          <!-- 图片区域 -->
          <view class="img-box" @click="previewImage(item.inputImg)">
            <image
              v-if="item.inputImg&&!item.inputImgErr"
              :src="item.inputImg"
              class="img"
              mode="aspectFill"
              @load="item.inputImgErr = false"
              @error="item.inputImgErr = true"
            ></image>
            <view v-else class="placeholder">
              <text class="placeholder-icon">📷</text>
              <text class="placeholder-text">{{item.inputImg?'加载失败':'无图'}}</text>
            </view>
          </view>
          
          <!-- 用户信息 -->
          <view class="item-info">
            <text class="username">{{ item.username || '匿名用户' }}</text>
            <text class="time">{{ item.startTime || '暂无时间' }}</text>
            <view class="role-tag" :class="item.role">
              <text class="role-text">{{ item.role === 'admin' ? '管理员' : '普通用户' }}</text>
            </view>
          </view>
          
          <!-- 按钮区 -->
          <view class="btn-area">
            <button class="btn detail-btn" @click.stop="openViewDialog(item)">详情</button>
            <button class="btn del-btn" v-if="userRole==='admin'" @click.stop="doDelete(item.id)">删除</button>
          </view>
        </view>
      </view>
    </scroll-view>

    <!-- 分页组件：完全复用参考页面的引入方式 -->
    <Pagination 
      v-if="filteredList.length > 0 && !loading"
      :current-page="currentPage"
      :total="filteredList.length"
      :page-size="pageSize"
      @prev="prevPage"
      @next="nextPage"
      @jump="jumpToPage"
    />

    <!-- 弹窗部分保持不变 -->
    <view class="dialog-mask" v-if="showDialog" @click="closeDialog"></view>
    <view class="dialog-wrap" v-if="showDialog">
      <view class="dialog-header">
        <text class="dialog-title">记录详情</text>
        <text class="dialog-close" @click="closeDialog">×</text>
      </view>
      <scroll-view class="dialog-content" scroll-y="true">
        <view class="detail-card">
          <view class="detail-grid">
            <view class="detail-item">
              <view class="detail-item-header">
                <text class="detail-item-icon">🆔</text>
                <text class="detail-item-label">记录ID</text>
              </view>
              <text class="detail-item-value">{{detail.id||'-'}}</text>
            </view>
            <view class="detail-item">
              <view class="detail-item-header">
                <text class="detail-item-icon">👤</text>
                <text class="detail-item-label">用户名</text>
              </view>
              <text class="detail-item-value">{{detail.username||'-'}}</text>
            </view>
            <view class="detail-item">
              <view class="detail-item-header">
                <text class="detail-item-icon">🏷️</text>
                <text class="detail-item-label">角色</text>
              </view>
              <text class="detail-item-value">{{detail.role==='admin'?'管理员':'普通用户'}}</text>
            </view>
            <view class="detail-item">
              <view class="detail-item-header">
                <text class="detail-item-icon">📝</text>
                <text class="detail-item-label">标签</text>
              </view>
              <text class="detail-item-value">{{detail.label||'-'}}</text>
            </view>
            <view class="detail-item">
              <view class="detail-item-header">
                <text class="detail-item-icon">🎯</text>
                <text class="detail-item-label">置信度</text>
              </view>
              <text class="detail-item-value">{{detail.conf||'0'}}</text>
            </view>
            <view class="detail-item">
              <view class="detail-item-header">
                <text class="detail-item-icon">🕒</text>
                <text class="detail-item-label">创建时间</text>
              </view>
              <text class="detail-item-value">{{detail.startTime||'-'}}</text>
            </view>
          </view>
        </view>
        
        <view style="margin-bottom: 10%;" class="img-container" v-if="detail.inputImg || detail.outImg">
          <view class="img-section" v-if="detail.inputImg">
            <view class="img-section-header">
              <text class="img-section-icon">📸</text>
              <text class="img-section-title">输入图片</text>
            </view>
            <view class="img-wrapper" @click="previewImage(detail.inputImg)">
              <image 
                v-if="!detail.inputImgErr" 
                :src="detail.inputImg" 
                class="detail-img" 
                @load="detail.inputImgErr = false"
                @error="detail.inputImgErr = true"
              ></image>
              <view v-else class="detail-img-placeholder">
                <text class="placeholder-icon">❌</text>
                <text>加载失败</text>
              </view>
            </view>
          </view>
          
          <view class="img-section" v-if="detail.outImg">
            <view class="img-section-header">
              <text class="img-section-icon">🔍</text>
              <text class="img-section-title">输出图片</text>
            </view>
            <view class="img-wrapper" @click="previewImage(detail.outImg)">
              <image 
                v-if="!detail.outImgErr" 
                :src="detail.outImg" 
                class="detail-img" 
                @load="detail.outImgErr = false"
                @error="detail.outImgErr = true"
              ></image>
              <view v-else class="detail-img-placeholder">
                <text class="placeholder-icon">❌</text>
                <text>加载失败</text>
              </view>
            </view>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>
</template>

<script setup lang="ts">
import { ref, computed, onMounted } from 'vue'
import { isLogin, getUserInfo } from '@/utils/userInfo.uts'
import { getImgRecordsAll, deleteImgRecord } from '@/api/imgRecords.uts'
// 1. 引入分页组件（和参考页面一致）
import Pagination from '@/components/Pagination.uvue'

interface ImgRecord{
  id:number;username:string;role:string;label?:string;conf?:string|number;
  startTime?:string;inputImg?:string;outImg?:string;inputImgErr?:boolean;outImgErr?:boolean;
}

const loading=ref(false),searchKeyword=ref('')
const userInfo=getUserInfo(),userRole=ref(userInfo?.role||'user'),userName=ref(userInfo?.username||'')
const roleOptions=ref([{label:'全部角色',value:''},{label:'管理员',value:'admin'},{label:'普通用户',value:'user'}])
const roleIndex=ref(0),filterUsername=ref('')
const currentPage=ref(1),pageSize=ref(4),jumpPage=ref<number|null>(null)
const list=ref<ImgRecord[]>([])
const filteredList=computed(()=>{
  let arr=[...list.value]
  if(searchKeyword.value)arr=arr.filter(x=>x.username.includes(searchKeyword.value))
  if(userRole.value==='admin'&&roleOptions.value[roleIndex.value].value)arr=arr.filter(x=>x.role===roleOptions.value[roleIndex.value].value)
  if(userRole.value==='admin'&&filterUsername.value)arr=arr.filter(x=>x.username===filterUsername.value)
  if(userRole.value!=='admin')arr=arr.filter(x=>x.username===userName.value)
  return arr
})
const totalPages=computed(()=>Math.ceil(filteredList.value.length/pageSize.value))
const currentPageData=computed(()=>filteredList.value.slice((currentPage.value-1)*pageSize.value,currentPage.value*pageSize.value))
const showDialog=ref(false),detail=ref<ImgRecord>({inputImgErr:false,outImgErr:false})

async function loadList(){
  if(!isLogin())return uni.redirectTo({url:'/pages/login/login'})
  loading.value=true
  try{
    const res=await getImgRecordsAll(userRole.value as any,userName.value)
    list.value=(res||[]).map(x=>({...x,inputImgErr:false,outImgErr:false}))
    currentPage.value=1
  }finally{loading.value=false}
}
function handleSearch(){clearTimeout((window as any).t);(window as any).t=setTimeout(()=>currentPage.value=1,300)}
function handleRoleChange(e:any){roleIndex.value=e.detail.value;currentPage.value=1}
function handleUsernameFilter(){currentPage.value=1}
function prevPage(){if(currentPage.value>1)currentPage.value--}
function nextPage(){if(currentPage.value<totalPages.value)currentPage.value++}

// 2. 修复jumpToPage方法：接收组件传递的页码参数（和参考页面一致）
function jumpToPage(targetPage: number) {
  if (!targetPage || targetPage < 1 || targetPage > totalPages.value) {
    uni.showToast({ title: `请输入1-${totalPages.value}之间的页码`, icon: 'none' });
    return;
  }
  currentPage.value = targetPage;
  jumpPage.value = null; // 清空输入框
}

// 保留原有方法（兼容），可删除
// function jumpToPage(){if(!jumpPage.value||jumpPage.value<1||jumpPage.value>totalPages.value)return;currentPage.value=jumpPage.value;jumpPage.value=null}

function openViewDialog(item:ImgRecord){detail.value={...item,inputImgErr:false,outImgErr:false};showDialog.value=true}
function closeDialog(){showDialog.value=false}
function previewImage(u:string){uni.previewImage({urls:[u],current:u})}
async function doDelete(id:number){
  uni.showModal({title:'确认删除',content:'删除后不可恢复',async success(r){
    if(r.confirm){loading.value=true;try{await deleteImgRecord(id);loadList()}finally{loading.value=false}}
  }})
}
onMounted(()=>loadList())
</script>

