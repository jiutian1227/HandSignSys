.avatar{
  width:140rpx;
  height:140rpx;
  border-radius:50%;
  border:6rpx solid #e8f4ff;
  box-shadow:0 10rpx 30rpx rgba(86,119,252,0.2);
  opacity:0.95; /* 头像透明度 */
}
.avatar-overlay{
  position:absolute;
  bottom:0;
  right:0;
  background:#5677fc;
  width:50rpx;
  height:50rpx;
  border-radius:50%;
  display:flex;
  align-items:center;
  justify-content:center;
  border:4rpx solid white;
  opacity:0.9; /* 头像操作按钮透明度 */
}
.camera-icon{font-size:24rpx}
.user-info{flex:1}
