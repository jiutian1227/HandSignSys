  box-sizing: border-box;
  opacity:0.95; /* 性别选项透明度 */
}
/* 选中状态美化 */
.sex-radio-item radio:checked + text {
  color: #5677fc;
  font-weight: 600;
}

.popup-actions{display:flex;gap:20rpx}
.action-btn{
  flex:1;
  height:80rpx;
  border-radius:40rpx;
  border:none;
  font-size:32rpx;
  opacity:0.95; /* 弹窗按钮透明度 */
}
.cancel-btn{background:#f5f5f5;color:#666}
.confirm-btn{background:#5677fc;color:white}
</style>