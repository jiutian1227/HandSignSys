{"code":"import {} from \"@/common/request\";\n/**\n * 上传图片到服务器（修复boundary问题）\n * @param filePath 本地图片临时路径\n * @returns 服务器返回的图片完整URL\n */\nexport function uploadImage(filePath) {\n    return new Promise((resolve, reject) => {\n        uni.uploadFile({\n            // url: 'http://localhost:9999/files/upload', \n            url: 'http://47.108.20.251:9999/files/upload',\n            filePath: filePath,\n            name: 'file',\n            header: new UTSJSONObject({\n                'Accept': 'application/json'\n            }),\n            // 上传成功回调\n            success: (res) => {\n                try {\n                    const data = UTS.JSON.parse(res.data);\n                    if (data.code === '200' || data.code === 200) {\n                        resolve(data);\n                    }\n                    else {\n                        reject(new Error(`上传失败：${data.msg || '接口返回错误'}`));\n                    }\n                }\n                catch (err) {\n                    reject(new Error(`解析上传结果失败：${err.message}`));\n                }\n            },\n            // 上传失败回调\n            fail: (err) => {\n                reject(new Error(`网络异常：${err.errMsg}`));\n            }\n        });\n    });\n}\n/**\n * 下载文件\n * @param flag\n */\nexport function downloadFile(flag) {\n    uni.downloadFile({\n        // url: `http://localhost:9999/files/${flag}`,\n        url: `http://47.108.20.251:9999/files/${flag}`,\n        success: (res) => {\n            if (res.statusCode === 200) {\n                uni.openDocument({\n                    filePath: res.tempFilePath,\n                    success: () => {\n                        uni.showToast({ title: '文件打开成功', icon: 'success' });\n                    },\n                    fail: (err) => {\n                        uni.showToast({ title: `打开失败：${err.errMsg}`, icon: 'none' });\n                    }\n                });\n            }\n        },\n        fail: (err) => {\n            uni.showToast({ title: `下载失败：${err.errMsg}`, icon: 'none' });\n        }\n    });\n}\n/**\n * 富文本编辑器图片上传\n * @param filePath 本地图片临时路径\n * @returns 富文本所需格式结果\n */\nexport function editorUploadImage(filePath) {\n    return new Promise((resolve, reject) => {\n        uni.uploadFile({\n            // url: 'http://localhost:9999/files/editor/upload',\n            url: 'http://47.108.20.251:9999/files/editor/upload',\n            filePath: filePath,\n            name: 'file',\n            header: new UTSJSONObject({\n                'Accept': 'application/json'\n            }),\n            success: (res) => {\n                try {\n                    const data = UTS.JSON.parse(res.data);\n                    resolve(data);\n                }\n                catch (err) {\n                    reject(new Error(`解析失败：${err.message}`));\n                }\n            },\n            fail: (err) => {\n                reject(new Error(`上传失败：${err.errMsg}`));\n            }\n        });\n    });\n}\n//# sourceMappingURL=E:/HBuilderProjects/HandSign/api/file.uts.js.map","references":[],"uniExtApis":["uni.uploadFile","uni.downloadFile","uni.openDocument","uni.showToast"],"map":"{\"version\":3,\"file\":\"file.uts.js\",\"sourceRoot\":\"\",\"sources\":[\"file.uts\"],\"names\":[],\"mappings\":\"AAAA,OAAY,EAAa,yBAA6B;AAEtD;;;;GAIG;AACH,MAAM,UAAU,WAAW,CAAC,QAAgB;IAC1C,OAAO,IAAI,OAAO,CAAC,CAAC,OAAO,EAAE,MAAM;QACjC,GAAG,CAAC,UAAU,CAAC;YACb,8CAA8C;YACjD,GAAG,EAAE,wCAAwC;YAC1C,QAAQ,EAAE,QAAQ;YAClB,IAAI,EAAE,MAAM;YACZ,MAAM,oBAAE;gBACN,QAAQ,EAAE,kBAAkB;aAC7B,CAAA;YACD,SAAS;YACT,OAAO,EAAE,CAAC,GAAG;gBACX,IAAI;oBACF,MAAM,IAAI,GAAG,SAAK,KAAK,CAAC,GAAG,CAAC,IAAI,CAAC,CAAC;oBAClC,IAAI,IAAI,CAAC,IAAI,KAAK,KAAK,IAAI,IAAI,CAAC,IAAI,KAAK,GAAG,EAAE;wBAC5C,OAAO,CAAC,IAAI,CAAC,CAAC;qBACf;yBAAM;wBACL,MAAM,CAAC,IAAI,KAAK,CAAC,QAAQ,IAAI,CAAC,GAAG,IAAI,QAAQ,EAAE,CAAC,CAAC,CAAC;qBACnD;iBACF;gBAAC,OAAO,GAAG,EAAE;oBACZ,MAAM,CAAC,IAAI,KAAK,CAAC,YAAa,GAAa,CAAC,OAAO,EAAE,CAAC,CAAC,CAAC;iBACzD;YACH,CAAC;YACD,SAAS;YACT,IAAI,EAAE,