}
.avatar-item.selected{
  border-color:#5677fc;
  transform:scale(1.05);
  opacity:1; /* 选中头像透明度100% */
}
.avatar-image{
  width:100%;
  height:100%;
  opacity:0.95; /* 头像图片透明度 */
}
.edit-form{margin-bottom:40rpx}
.form-item{margin-bottom:30rpx}
.form-label{
  display:block;
  font-size:28rpx;
  color:#333;
  margin-bottom:10rpx;
  opacity:0.95; /* 表单标签透明度 */
}
.form-input{
  width:100%;
  height:80rpx;
  padding:0 20rpx;
  border:2rpx solid #e5e5e5;
  border-radius:10rpx;
  font-size:28rpx;
  box-sizing:border-box;
  opacity:0.9; /* 表单输入框透明度 */
}

/* 性别选项网格布局核心样式 */
.sex-radio-group{width:100%}
.sex-grid{
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  width: 100%;
}
