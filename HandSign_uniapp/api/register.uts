import { post } from '@/common/request.uts';

/**
 * 注册参数类型定义
 */
export interface RegisterParams {
  username: string;
  password: string;
}

/**
 * 调用后端注册接口
 * @param params 注册参数（用户名+密码）
 * @returns Promise<ApiResult<any>>
 */
export function userRegister(params: RegisterParams) {
  return post('/user/register', params);
}