<template>
  <view class="login-page">
    <view class="bg-layer">
      <image class="bg-img" src="" mode="scaleToFill"></image>
      <view class="mask"></view>
    </view>

    <view class="content-wrapper">
      <view class="title-box">
        <text class="main-title">手语识别系统 - 用户登录</text>
        <text class="sub-title">Sign Language Recognition</text>
      </view>

      <view class="login-container">
        <view class="form-item">
          <view class="input-wrapper">
            <text class="input-icon">👤</text>
            <input v-model="username" type="text" placeholder="请输入用户名" class="input-box" />
          </view>
        </view>
        <view class="form-item">
          <view class="input-wrapper">
            <text class="input-icon">🔒</text>
            <input v-model="password" type="password" placeholder="请输入密码" class="input-box" />
          </view>
        </view>

        <view class="form-item">
          <view class="input-wrapper captcha-wrapper">
            <text class="input-icon">🔢</text>
            <input v-model="captchaAnswer" type="number" placeholder="请输入验证码答案" class="input-box captcha-input" />
            <image :src="captchaUrl" @click="refreshCaptcha" class="captcha-img" mode="widthFix"></image>
            <text @click="refreshCaptcha" class="refresh-icon">🔄</text>
          </view>
        </view>

        <button class="login-btn" @click="handleLogin" :disabled="isLoading">
          {{ isLoading ? '登录中...' : '登录' }}
        </button>
        <view class="link-box">
          <text @click="goRegister" class="register-link">还没有账号？去注册</text>
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
import { ref, onMounted } from 'vue';
import { userLogin, type LoginParams } from '@/api/login.uts';
import { getCaptcha, checkCaptcha, type CaptchaGetResult } from '@/api/captcha.uts';
import type { ApiResult } from '@/common/request.uts';
import { setUserInfo, isLogin } from '@/utils/userInfo.uts';
const username = ref('');
const password = ref('');
const captchaAnswer = ref('');
const captchaUrl = ref('');
const captchaToken = ref('');
const isLoading = ref(false);

onMounted(() => {
  refreshCaptcha();
  if (isLogin()) {
    uni.switchTab({ url: '/pages/index/index' });
  }
});
const refreshCaptcha = async () => {
  try {
    const res = await getCaptcha() as ApiResult<CaptchaGetResult>;
    captchaUrl.value = res.data.captchaImage;
    captchaToken.value = res.data.captchaToken;
    captchaAnswer.value = '';
  } catch (err) {
    uni.showToast({ title: '验证码加载失败', icon: 'none' });
  }
};

const handleLogin = async () => {
  if (!username.value) return uni.showToast({ title: '请输入用户名', icon: 'none' });
  if (!password.value) return uni.showToast({ title: '请输入密码', icon: 'none' });
  if (!captchaAnswer.value) return uni.showToast({ title: '请输入验证码', icon: 'none' });
  if (!captchaToken.value) return uni.showToast({ title: '请刷新验证码', icon: 'none' });

  isLoading.value = true;
  try {
    // 校验验证码
    const captchaRes = await checkCaptcha({ 
      captchaToken: captchaToken.value,
      userAnswer: captchaAnswer.value 
    });
    
    // 验证码校验成功，执行登录
    const loginParams: LoginParams = { username: username.value, password: password.value };
    const loginRes = await userLogin(loginParams) as ApiResult<any>;
    setUserInfo(loginRes.data);
    uni.showToast({ title: '登录成功', icon: 'success', duration: 1500 });
    
    setTimeout(() => {
      uni.switchTab({
        url: '/pages/index/index',
        fail: () => uni.navigateTo({ url: '/pages/index/index' })
      });
    }, 1500);
  } catch (err: any) {
    uni.showToast({ title: err.msg || '登录失败', icon: 'none' });
    refreshCaptcha(); // 校验失败自动刷新验证码
  } finally {
    isLoading.value = false;
  }
};

const goRegister = () => {
  uni.navigateTo({
    url: '/pages/register/register',
    fail: () => uni.showToast({ title: '注册页跳转失败', icon: 'none' })
  });
};
</script>

<style scoped>
