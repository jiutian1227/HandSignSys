  backdrop-filter:blur(10rpx);
  z-index:1;
  opacity:0.85; /* 弹窗遮罩透明度 */
}
.popup-content{
  position:relative;
  background:white;
  border-radius:30rpx;
  padding:40rpx;
  margin:0 30rpx;
  width:90%;
  max-width:600rpx;
  max-height:80vh;
  overflow-y:auto;
  box-shadow:0 20rpx 60rpx rgba(0,0,0,0.3);
  z-index:2;
  opacity:0.95; /* 弹窗内容透明度 */
}
.edit-content{max-height:90vh}
.popup-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:40rpx}
.popup-title{
  font-size:36rpx;
