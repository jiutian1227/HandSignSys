// 导入common目录下的request工具（包含新增的del方法）
import { get, post, del } from "@/common/request.uts";

/**
 * 图片记录类型（完全匹配后端实体字段）
 */
export interface ImgRecords {
  id?: number;               // 主键ID（自增）
  weight?: string;           // 重量
  inputImg?: string;         // 输入图片
  outImg?: string;           // 输出图片
  confidence?: string;       // 置信度（confidence）
  allTime?: string;          // 总耗时
  conf?: string;             // 置信度（conf）
  label?: string;            // 标签
  username?: string;         // 用户名
  startTime?: string;        // 开始时间
}

/**
 * 获取图片记录列表（支持角色权限控制）
 * @param role 角色：admin / user（必填）
 * @param username 用户名（user角色时必填）
 */
export const getImgRecordsAll = async (
  role: "admin" | "user",
  username?: string
) => {
  if (role === "user" && !username) {
    uni.showToast({ title: "普通用户查询需传入用户名", icon: "none" });
    throw new Error("普通用户查询需传入用户名");
  }

  const params: Record<string, string> = { role };
  if (username) params.username = username;
  const result = await get<ImgRecords[]>("/imgRecords/all", params);
  return (result as { data: ImgRecords[] }).data;
};

/**
 * 根据ID获取单条记录
 * @param id 记录ID
 */
export const getImgRecordById = async (id: number) => {
  const result = await get<ImgRecords>(`/imgRecords/${id}`);
  return (result as { data: ImgRecords }).data;
};

/**
 * 分页查询图片记录
 * @param pageNum 页码（默认1）
 * @param pageSize 页大小（默认10）
 * @param searchParams 搜索参数（username/startTime/label/conf）
 */
export const getImgRecordsPage = async (
  pageNum: number = 1,
  pageSize: number = 10,
  searchParams: {
    search?: string;  // username模糊查询
    search1?: string; // startTime模糊查询
    search2?: string; // label模糊查询
    search3?: string; // conf模糊查询
  } = {}
) => {
  const params = {
    pageNum,
    pageSize,
    ...searchParams
  };
  const result = await get<{
    records: ImgRecords[];
    total: number;
    size: number;
    current: number;
  }>("/imgRecords", params);
  return (result as { data: any }).data;
};

/**
 * 删除图片记录
 * @param id 记录ID
 */
export const deleteImgRecord = async (id: number) => {
  const result = await del<null>(`/imgRecords/${id}`);
  return (result as { data: null }).data;
};

/**
 * 修改图片记录
 * @param record 要修改的记录（必须包含id）
 */
export const updateImgRecord = async (record: ImgRecords) => {
  if (!record.id) {
    uni.showToast({ title: "修改记录必须包含ID", icon: "none" });
    throw new Error("修改记录必须包含ID");
  }
  const result = await post<ImgRecords>("/imgRecords/update", record);
  return (result as { data: ImgRecords }).data;
};

/**
 * 新增图片记录
 * @param record 要新增的记录
 */
export const addImgRecord = async (record: ImgRecords) => {
  const result = await post<ImgRecords>("/imgRecords", record);
  return (result as { data: ImgRecords }).data;
};