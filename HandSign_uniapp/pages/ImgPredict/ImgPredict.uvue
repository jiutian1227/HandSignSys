  border: none;
}

.btn-text {
  font-size: 30rpx;
  color: #ffffff;
  font-weight: 500;
}

.reset-btn .btn-text {
  color: #5a6c7d;
}

.upload-area {
  width: 100%;
  height: 400rpx;
  border: 2px dashed #c0c4cc;
