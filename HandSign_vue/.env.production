# 线上环境
ENV = 'production'

VITE_API_URL = ''
# 生产构建无 Vite 代理；若前端页面与 *.fanzengxie.icu 不同源，需在 Nginx/Flask 上配置 CORS，否则 /file_names 等跨域请求会失败
VITE_USE_DEV_PROXY = false

# 前端直连后端
VITE_SPRING_ORIGIN = https://springboot.fanzengxie.icu
VITE_FLASK_ORIGIN = https://flask.fanzengxie.icu
VITE_PUBLIC_FILE_BASE = https://springboot.fanzengxie.icu

# Socket
VITE_PROXY_FLASK_TARGET = https://flask.fanzengxie.icu
VITE_SOCKET_URL = https://flask.fanzengxie.icu

# 可选：仅当 VITE_USE_DEV_PROXY=true 时使用
VITE_PROXY_API_TARGET = https://springboot.fanzengxie.icu

# 文件上传直链域名
VITE_STATIC_FILE_ORIGIN = https://springboot.fanzengxie.icu