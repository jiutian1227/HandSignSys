<script setup lang="ts">
import { ref, computed, onMounted } from 'vue'
// 仅导入原有工具类，不做任何修改
import { getUserInfo, getUserRole, isLogin } from '@/utils/userInfo.uts'
// 导入原有 UserInfo 类型（确保类型匹配）
import type { UserInfo } from '@/utils/userInfo.uts'



// 页面路由配置（保持不变）
const pageConfig = {
  RealTimeRecognition: {
    url: '/pages/CameraPredict/index',
    isTabBar: true
  },
  ImageRecognition: {
    url: '/pages/ImgPredict/ImgPredict',
    isTabBar: false
  },
  ImageRecognitionRecord: {
    url: '/pages/imgRecords/imgRecords',
    isTabBar: false
  },
  RealTimeRecognitionRecord: {
    url: '/pages/CameraRecords/CameraRecords',
    isTabBar: false
  },
  UserList: {
    url: '/pages/UserList/UserList',
    isTabBar: false
  }
}

const navigateTo = (page: string) => {

  const pageInfo = pageConfig[page as keyof typeof pageConfig]
  
  if (!pageInfo) {
    uni.showToast({
      title: `页面 ${page} 不存在`,
      icon: 'none'
    })
    return
  }

  if (pageInfo.isTabBar) {
    uni.switchTab({
      url: pageInfo.url,
      fail: (err) => {
        console.error('tabBar页面跳转失败:', err)
        uni.showToast({
          title: '页面跳转失败',
          icon: 'none'
        })
      }
    })
  } else {
    uni.navigateTo({
      url: pageInfo.url,
      fail: (err) => {
        console.error('普通页面跳转失败:', err)
        uni.showToast({
          title: '页面跳转失败',
          icon: 'none'
        })
      }
    })
  }
}

// 未实现功能提示（保持不变）
const showUnimplementedTip = () => {
  uni.showToast({
    title: '功能暂未实现',
    icon: 'none',
    duration: 1500
  })
}

// 页面加载时刷新用户信息（确保最新状态）
onMounted(() => {
  // 重新获取用户信息，更新状态
  userInfo.value = getUserInfo()
})
</script>

