  box-shadow: 0 6rpx 16rpx rgba(52, 152, 219, 0.3);
  transition: all 0.3s ease;
}

.login-btn:disabled {
  background: linear-gradient(90deg, #95a5a6, #7f8c8d);
  box-shadow: none;
}

.login-btn:active:not(:disabled) {
  transform: scale(0.98);
