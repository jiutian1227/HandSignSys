<template>
  <view class="ai-container">
    <view class="bg-decor">
      <view class="bg-mask"></view>
    </view>

    <view class="top-decor">
      <view class="top-icon-wrap">
        <text class="hand-icon">✋</text>
      </view>
    </view>

    <view class="main-card">
      <view class="title-wrap">
        <text class="main-title">手语AI实时识别</text>
        <text class="sub-title">智能解析 · 精准识别</text>
      </view>

      <view class="form-item">
        <view class="item-label">
          <text class="icon-text">⚙️</text>
          <text class="label-text">识别模型</text>
        </view>
        <picker mode="selector" :range="state.weight_items" :range-key="'label'" @change="onModelChange" class="custom-picker">
          <view class="picker-wrap-horizontal">
            <text class="picker-label">{{ state.selectedModel.label }}</text>
            <text class="arrow-icon-horizontal">→</text>
          </view>
        </picker>
      </view>

      <view class="form-item">
        <view class="item-label">
          <text class="icon-text">%</text>
          <text class="label-text">识别置信度</text>
        </view>
        <view class="conf-btns-horizontal">
          <button class="conf-btn" @click="setConf(-1)">−</button>
          <text class="conf-value">{{ state.conf.toFixed(2) }}</text>
          <button class="conf-btn" @click="setConf(1)">+</button>
        </view>
        <text class="conf-tip">每次调整 0.05，范围 0.10 ~ 1.00</text>
      </view>

      <view class="reset-btn-wrap">
        <button class="reset-btn" @click="resetToDefault">
          <text class="icon-text">↺</text>
          <text class="reset-text">恢复默认值</text>
        </button>
      </view>

      <view class="action-btn-group-horizontal">
        <button 
          class="action-btn-high primary" 
          @click="startCamera" 
          :disabled="state.isCameraRunning"
        >
          <text class="icon-text" v-if="!state.isCameraRunning">📷</text>
          <text class="loading-icon" v-else>◯</text>
          <text class="btn-text">{{ state.isCameraRunning ? '识别中' : '启动识别' }}</text>
        </button>
        <button 
          class="action-btn-high cancel" 
          @click="stopCamera" 
          v-if="state.isCameraRunning"
        >
          <text class="icon-text">✕</text>
          <text class="btn-text">停止识别</text>
        </button>
      </view>
    </view>

    <view class="video-wrap" v-if="state.isCameraRunning">
      <view class="video-header">
        <text class="video-title">实时识别画面</text>
        <text class="video-subtitle">模型：{{ state.selectedModel.label }} | 置信度：{{ state.conf.toFixed(2) }}</text>
      </view>
      <view class="video-container">
      
        <!-- 摄像头正常显示 -->
        <camera 
          v-if="state.isCameraRunning"
          class="real-camera"
          device-position="front"
          flash="off"
        ></camera>

        <!-- 识别结果覆盖显示 -->
        <image 
          :src="state.videoStreamUrl" 
          class="video-img"
          mode="aspectFit" 
        />
        
        <view class="loading-mask" v-if="!state.videoStreamUrl">
          <text class="loading-spin">◯</text>
          <text class="loading-text">正在初始化摄像头...</text>
        </view>
      </view>
    </view>

    <view class="status-wrap" :class="getStatusClass()">
      <text class="status-icon" :style="{ color: getStatusColor() }">{{ getStatusIcon() }}</text>
      <text class="status-text">{{ state.statusMsg }}</text>
    </view>

    <view class="bottom-decor">
    </view>
  </view>
</template>

<script setup lang="uts">
import { reactive, onMounted, onUnmounted } from 'vue';
import { getUserInfo } from '@/utils/userInfo.uts';
import { 
  getModelList, 
  predictFrame, 
  finalizeCameraSession, 
  formatDateTime 
} from '@/common/aiRecognitionApi.uts';

const DEFAULT_CONFIG = {
  DEFAULT_MODEL: { label: 'YOLOv8n 轻量模型', value: 'yolov8n.pt' },
  DEFAULT_CONF: 0.7,
  STEP: 0.05,
  MIN_CONF: 0.1,
  MAX_CONF: 1.0,
  STATUS_TYPE: {
    SUCCESS: 'success',
    INFO: 'info',
    WARNING: 'warning',
    ERROR: 'error'
  }
};

interface WeightItem {
  label: string;
  value: string;
}

const state = reactive({
  weight_items: [] as WeightItem[],
  selectedModel: { ...DEFAULT_CONFIG.DEFAULT_MODEL },
  conf: DEFAULT_CONFIG.DEFAULT_CONF,
  isCameraRunning: false,
  videoStreamUrl: '',
  statusMsg: '就绪 - 已加载默认配置',
  statusType: DEFAULT_CONFIG.STATUS_TYPE.INFO,
  username: 'test_user',
  sessionId: ''
});

let frameTimer: any = null;
let cameraContext: any = null;
let isProcessing = false; // 防重复请求

onMounted(() => {
  initModelList();
  cameraContext = uni.createCameraContext();
});

onUnmounted(() => {
  stopCamera();
});

const initModelList = () => {
  state.statusMsg = '正在加载模型列表...';
  getModelList().then((res: any) => {
    try {
      if (res?.weight_items?.length) {
        state.weight_items = res.weight_items as WeightItem[];
        const defaultModel = state.weight_items.find(item => item.value === DEFAULT_CONFIG.DEFAULT_MODEL.value);
        state.selectedModel = defaultModel || state.weight_items[0];
        state.statusMsg = `加载完成：${state.selectedModel.label}`;
      } else {
        state.weight_items = [DEFAULT_CONFIG.DEFAULT_MODEL];
      }
    } catch (e) {
      state.weight_items = [DEFAULT_CONFIG.DEFAULT_MODEL];
    }
  }).catch(() => {
    state.weight_items = [DEFAULT_CONFIG.DEFAULT_MODEL];
  });
};

const onModelChange = (e: any) => {
  const index = e.detail.value;
  state.selectedModel = state.weight_items[index];
  state.statusMsg = `已切换：${state.selectedModel.label}`;
};

const setConf = (dir: number) => {
  let newConf = state.conf + dir * DEFAULT_CONFIG.STEP;
  newConf = Math.max(DEFAULT_CONFIG.MIN_CONF, Math.min(DEFAULT_CONFIG.MAX_CONF, newConf));
  state.conf = newConf;
  state.statusMsg = `置信度：${newConf.toFixed(2)}`;
};

const resetToDefault = () => {
  state.selectedModel = { ...DEFAULT_CONFIG.DEFAULT_MODEL };
  state.conf = DEFAULT_CONFIG.DEFAULT_CONF;
  state.statusMsg = '已恢复默认配置';
  uni.showToast({ title: '已恢复默认', icon: 'success' });
};

// ======================
// 启动摄像头
// ======================
const startCamera = () => {
  if (!state.selectedModel?.value) {
    uni.showToast({ title: '请选择模型', icon: 'none' });
    return;
  }

  state.isCameraRunning = true;
  state.videoStreamUrl = '';
  state.sessionId = 'sess_' + Date.now();
  state.statusMsg = '正在启动实时识别...';

  startFrameLoop();
};

// ======================
// 核心：防重复请求 + 降低帧率
// ======================
function startFrameLoop() {
  if (frameTimer) clearInterval(frameTimer);

  frameTimer = setInterval(() => {
    if (!state.isCameraRunning || isProcessing) return;
    isProcessing = true;

    cameraContext.takePhoto({
      quality: 'low',
      success: (res) => {
        uni.getFileSystemManager().readFile({
          filePath: res.tempImagePath,
          encoding: 'base64',
          success: (data) => {
            predictFrame({
              weight: state.selectedModel.value,
              conf: parseFloat(state.conf.toFixed(2)),
              frame: data.data,
              sessionId: state.sessionId
            }).then((resp: any) => {
              if (resp?.status === 200) {
                state.videoStreamUrl = 'data:image/jpeg;base64,' + resp.outFrame;
                state.statusMsg = '✅ 实时识别中';
              }
            }).catch(() => {
              // 出错不崩溃
            }).finally(() => {
              isProcessing = false;
            });
          },
          fail: () => {
            isProcessing = false;
          }
        });
      },
      fail: () => {
        isProcessing = false;
      }
    });
  }, 500); // 👈 500ms 一次，绝对不超时
}

// ======================
// 停止摄像头
// ======================
const stopCamera = () => {
  state.isCameraRunning = false;
  state.videoStreamUrl = '';

  if (frameTimer) {
    clearInterval(frameTimer);
    frameTimer = null;
  }

  finalizeCameraSession({
    sessionId: state.sessionId,
    username: getUserInfo()?.username || 'test_user',
    weight: state.selectedModel.value,
     conf: parseFloat(state.conf.toFixed(2)),
    startTime: formatDateTime(new Date())
  }).finally(() => {
    state.statusMsg = '✅ 识别已停止';
  });
};

const getStatusClass = () => {
  switch (state.statusType) {
    case DEFAULT_CONFIG.STATUS_TYPE.SUCCESS: return 'status-success';
    case DEFAULT_CONFIG.STATUS_TYPE.ERROR: return 'status-error';
    case DEFAULT_CONFIG.STATUS_TYPE.WARNING: return 'status-warning';
    default: return 'status-info';
  }
};

const getStatusColor = () => {
  switch (state.statusType) {
    case DEFAULT_CONFIG.STATUS_TYPE.SUCCESS: return '#4cd964';
    case DEFAULT_CONFIG.STATUS_TYPE.ERROR: return '#ff3b30';
    case DEFAULT_CONFIG.STATUS_TYPE.WARNING: return '#ff9500';
    default: return '#667eea';
  }
};

const getStatusIcon = () => {
  switch (state.statusType) {
    case DEFAULT_CONFIG.STATUS_TYPE.SUCCESS: return '✓';
    case DEFAULT_CONFIG.STATUS_TYPE.ERROR: return '✕';
    case DEFAULT_CONFIG.STATUS_TYPE.WARNING: return '⚠️';
    default: return 'ℹ️';
  }
};
</script>


