  background: linear-gradient(180deg, rgba(255, 255, 255, 0.9) 0%, rgba(255, 255, 255, 0.85) 100%);
}

.content-wrapper {
  position: relative;
  z-index: 1;
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 0 40rpx;
  box-sizing: border-box;
  background-image:  url('https://free.picui.cn/free/2026/03/08/69ad28f585a3f.png');
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
}

.title-box {
  text-align: center;
  margin-bottom: 80rpx;
}

.main-title {
  font-size: 48rpx;
  font-weight: bold;
  color: #2c3e50;
  display: block;
  margin-bottom: 16rpx;
}

.sub-title {
  font-size: 24rpx;
  color: #7f8c8d;
  font-family: 'Arial', sans-serif;
  display: block;
}

.login-container {
  background: #ffffff;
  padding: 60rpx 40rpx;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.08);
  opacity: 0.75;
}

.form-item {
  margin-bottom: 36rpx;
}

.input-wrapper {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: flex-start;
  height: 98rpx;
  padding: 0 24rpx;
  border: 2rpx solid #e8f4f8;
  border-radius: 16rpx;
  background-color: #f8f9fa;
  transition: all 0.3s ease;
  box-sizing: border-box;
}

.input-wrapper:focus-within {
  border-color: #3498db;
  box-shadow: 0 0 0 6rpx rgba(52, 152, 219, 0.1);
}

.input-icon {
  font-size: 32rpx;
  color: #95a5a6;
  margin-right: 20rpx;
  line-height: 1;
  flex-shrink: 0; 
  padding: 5rpx;
}

.input-box {
  flex: 1;
  height: 100%;
  font-size: 32rpx;
  color: #2c3e50;
  background: transparent;
  border: none;
  padding: 0;
  margin: 0;
  box-sizing: border-box;
}

.input-box::placeholder {
  color: #bdc3c7;
  font-size: 30rpx;
}

.login-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background: linear-gradient(90deg, #3498db, #2980b9);
  color: #ffffff;
  border-radius: 16rpx;
