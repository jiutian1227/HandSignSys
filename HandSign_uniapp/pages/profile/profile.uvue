  width:100%;
  height:100rpx;
  background:rgba(255,255,255,0.85);
  backdrop-filter:blur(20rpx);
  border-radius:25rpx;
  border:none;
  display:flex;
  align-items:center;
  justify-content:center;
  gap:15rpx;
  box-shadow:0 10rpx 30rpx rgba(0,0,0,0.1);
  font-size:32rpx;
  color:#ff4757;
  opacity:0.9; /* 退出按钮透明度 */
}

/* 弹窗相关 - 添加透明度 */
.avatar-popup,.edit-popup{position:fixed;top:0;left:0;width:100%;height:100%;z-index:9999;display:flex;align-items:center;justify-content:center}
.popup-overlay{
  position:absolute;
