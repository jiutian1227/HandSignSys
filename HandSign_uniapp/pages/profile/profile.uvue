<template>
  <view class="profile">
    <view v-if="loading" class="loading">加载中...</view>
    <view v-else>
      <view class="header-card">
        <view class="user-main-info">
          <view class="avatar-section">
            <image class="avatar" :src="userInfo.avatar || defaultAvatar" mode="aspectFill" />
            <view class="avatar-overlay" @click="showAvatarPopup">
              <text class="camera-icon">📷</text>
            </view>
          </view>
          <view class="user-info">
            <text class="username">{{ userInfo.username || '未设置用户名' }}</text>
            <view class="role-badge">{{ roleText }}</view>
          </view>
        </view>
      </view>
      <view class="info-card">
        <view class="card-header">
          <text class="card-icon">📋</text>
          <text class="card-title">基本信息</text>
        </view>
        <view class="info-grid">
          <view class="info-item">
            <view class="info-left">
              <text class="info-icon">🆔</text>
              <text class="info-label">用户ID</text>
            </view>
            <text class="info-value">{{ userInfo.id || '--' }}</text>
          </view>
          <view class="info-item">
            <view class="info-left">
              <text class="info-icon">👤</text>
              <text class="info-label">用户名</text>
            </view>
            <text class="info-value">{{ userInfo.username || '--' }}</text>
          </view>
          <view class="info-item">
            <view class="info-left">
              <text class="info-icon">🎭</text>
              <text class="info-label">角色</text>
            </view>
            <text class="info-value">{{ roleText }}</text>
          </view>
          <view class="info-item">
            <view class="info-left">
              <text class="info-icon">✍️</text>
              <text class="info-label">姓名</text>
            </view>
            <text class="info-value">{{ userInfo.name || '--' }}</text>
          </view>
          <view class="info-item">
            <view class="info-left">
              <text class="info-icon">📧</text>
              <text class="info-label">邮箱</text>
            </view>
            <text class="info-value">{{ userInfo.email || '--' }}</text>
          </view>
          <view class="info-item">
            <view class="info-left">
              <text class="info-icon">📱</text>
              <text class="info-label">手机号</text>
            </view>
            <text class="info-value">{{ userInfo.tel || '--' }}</text>
          </view>
          <view class="info-item">
            <view class="info-left">
              <text class="info-icon">🚻</text>
              <text class="info-label">性别</text>
            </view>
            <text class="info-value">{{ userInfo.sex || '--' }}</text>
          </view>
          <view class="info-item">
            <view class="info-left">
              <text class="info-icon">📅</text>
              <text class="info-label">注册时间</text>
            </view>
            <text class="info-value">{{ formatDate(userInfo.time) }}</text>
          </view>
        </view>
      </view>
      <view class="action-card">
        <view class="card-header">
          <text class="card-icon">⚡</text>
          <text class="card-title">快捷操作</text>
        </view>
        <view class="action-grid">
          <view class="action-item" @click="showEditPopup">
            <view class="action-icon borrow-icon">✏️</view>
            <text class="action-text">修改信息</text>
          </view>
          <view class="action-item" @click="showAvatarPopup">
            <view class="action-icon avatar-icon">🖼️</view>
            <text class="action-text">更换头像</text>
          </view>
        </view>
      </view>
      <view class="logout-section">
        <button class="logout-btn" @click="handleLogout">
          <text class="logout-icon">🚪</text>
          <text class="logout-text">退出登录</text>
        </button>
      </view>
    </view>
    <view class="avatar-popup" v-if="showAvatarSelect">
      <view class="popup-overlay" @click="hideAvatarPopup"></view>
      <view class="popup-content">
        <view class="popup-header">
          <text class="popup-title">选择头像</text>
          <text class="popup-close" @click="hideAvatarPopup">×</text>
        </view>
        <view class="avatar-grid">
          <view v-for="(avatar, index) in avatarList" :key="index" class="avatar-item" :class="{ selected: selectedAvatar === avatar }" @click="selectAvatar(avatar)">
            <image class="avatar-image" :src="avatar" mode="aspectFill" />
          </view>
        </view>
        <view class="popup-actions">
          <button class="action-btn cancel-btn" @click="hideAvatarPopup">取消</button>
          <button class="action-btn confirm-btn" @click="confirmAvatarChange">确定</button>
        </view>
      </view>
    </view>
    <view class="edit-popup" v-if="showEditSelect">
      <view class="popup-overlay" @click="hideEditPopup"></view>
      <view class="popup-content edit-content">
        <view class="popup-header">
          <text class="popup-title">修改个人信息</text>
          <text class="popup-close" @click="hideEditPopup">×</text>
        </view>
        <view class="edit-form">
          <view class="form-item">
            <text class="form-label">姓名</text>
            <input class="form-input" v-model="editForm.name" placeholder="请输入真实姓名" />
          </view>
          <view class="form-item">
            <text class="form-label">性别</text>
            <radio-group class="sex-radio-group" @change="editForm.sex = $event.detail.value">
              <view class="sex-grid">
                <label class="sex-radio-item">
                  <radio value="男" :checked="editForm.sex === '男'">男</radio>
                </label>
                <label class="sex-radio-item">
                  <radio value="女" :checked="editForm.sex === '女'">女</radio>
                </label>
              </view>
            </radio-group>
          </view>
          <view class="form-item">
            <text class="form-label">邮箱</text>
            <input class="form-input" v-model="editForm.email" type="email" placeholder="请输入邮箱" />
          </view>
          <view class="form-item">
            <text class="form-label">手机号</text>
            <input class="form-input" v-model="editForm.tel" type="number" placeholder="请输入手机号" />
          </view>
          <view class="form-item" v-if="userInfo.role === 'admin'">
            <text class="form-label">密码（选填）</text>
            <input class="form-input" v-model="editForm.password" type="password" placeholder="不修改请留空" />
          </view>
        </view>
        <view class="popup-actions">
          <button class="action-btn cancel-btn" @click="hideEditPopup">取消</button>
          <button class="action-btn confirm-btn" @click="confirmEditInfo">保存修改</button>
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="ts">
import { ref, computed, onMounted } from 'vue'
import { updateUser, getUserByUsername } from '@/api/user.uts'
import {  logout,isLogin, getUserInfo,setUserInfo } from '@/utils/userInfo.uts'
import type { User } from '@/api/user.uts'

const loading = ref(true)
const defaultAvatar = "https://img.tuxiangyan.com/uploads/allimg/230530/1_05300UH241a.jpg"
const userInfo = ref<User>({})
const showAvatarSelect = ref(false)
const selectedAvatar = ref('')
const avatarList = ref([
  defaultAvatar,
  'https://img.tuxiangyan.com/uploads/allimg/230622/1_0622163TEQ4.jpg',
  'https://tse1-mm.cn.bing.net/th/id/OIP-C.jtxvfcOpgNXyOTcmPwkGYAAAAA?w=194&h=194&c=7&r=0&o=7&cb=iwp1&dpr=1.3&pid=1.7&rm=3',
  'https://img.tuxiangyan.com/uploads/allimg/220101/1_01011952032O4.jpg',
  'https://img.tuxiangyan.com/uploads/allimg/220101/1_010119515532F.jpg',
  'https://img.52tiemo.com/uploads/allimg/210526/3-210526154Z0.jpg',
  'https://img.52tiemo.com/uploads/allimg/210526/3-210526154Z0-50.jpg',
  'https://img.52tiemo.com/uploads/allimg/210526/3-210526154U9.jpg',
  'https://img.52tiemo.com/uploads/allimg/210526/3-210526154U8.jpg',
  'https://img.52tiemo.com/uploads/allimg/210526/3-210526154U7.jpg',
  'https://img.52tiemo.com/uploads/allimg/210526/3-210526154U1-50.jpg',
  'https://img.tuxiangyan.com/zb_users/upload/2023/02/202302091675904133424061.jpg',
  'https://img.tuxiangyan.com/zb_users/upload/2023/02/202302091675904133140322.jpg',
  'https://img.tuxiangyan.com/zb_users/upload/2023/02/202302091675904134274530.jpg',
  'https://img.tuxiangyan.com/zb_users/upload/2023/02/202302091675904134814455.jpg',
  'https://img.tuxiangyan.com/zb_users/upload/2023/02/202302091675904134287530.jpg',
  'https://img.tuxiangyan.com/zb_users/upload/2023/02/202302091675904134748531.jpg',
  'https://img.tuxiangyan.com/zb_users/upload/2023/02/202302091675904134407256.jpg',
  'https://img.tuxiangyan.com/zb_users/upload/2023/02/202302091675904134149776.jpg',
  'https://img.tuxiangyan.com/zb_users/upload/2023/02/202302091675904134262080.jpg',
  'https://img.tuxiangyan.com/zb_users/upload/2023/02/202302091675904136317214.jpg',
  'https://img.tuxiangyan.com/zb_users/upload/2023/02/202302091675904136409043.jpg'
])
const showEditSelect = ref(false)
const editForm = ref<User>({})

const roleText = computed(() => {
  const map: Record<string, string> = {
    admin: '管理员',
    user: '普通用户'
  }
  return map[userInfo.value.role || ''] || '未知角色'
})

const formatDate = (s?: string) => {
  if (!s) return '--'
  return new Date(s).toLocaleDateString('zh-CN')
}

async function loadUser() {
  try {
    if (isLogin()) {
      const localUser = getUserInfo()
      userInfo.value = localUser
      if (localUser.username) {
        const freshUser = await getUserByUsername(localUser.username)
        userInfo.value = freshUser
      }
      initEditForm()
    } else {
      uni.showToast({ title: '请先登录', icon: 'none' })
      uni.navigateTo({ url: '/pages/login/login' })
    }
  } catch (e) {
    uni.showToast({ title: '加载信息失败', icon: 'none' })
  } finally {
    loading.value = false
  }
}

function initEditForm() {
  editForm.value = {
    id: userInfo.value.id,
    username: userInfo.value.username,
    name: userInfo.value.name || '',
    sex: userInfo.value.sex || '男',
    email: userInfo.value.email || '',
    tel: userInfo.value.tel || '',
    role: userInfo.value.role
  }
}

const showEditPopup = () => {
  initEditForm()
  showEditSelect.value = true
}

const hideEditPopup = () => {
  showEditSelect.value = false
}

const confirmEditInfo = async () => {
  if (editForm.value.tel && !/^1[3-9]\d{9}$/.test(editForm.value.tel)) {
    uni.showToast({ title: '手机号格式错误', icon: 'none' })
    return
  }
  if (editForm.value.email && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(editForm.value.email)) {
    uni.showToast({ title: '邮箱格式错误', icon: 'none' })
    return
  }
  await updateUser(editForm.value)
  userInfo.value = { ...userInfo.value, ...editForm.value }
  editForm.value.password = ''
  uni.showToast({ title: '修改成功', icon: 'success' })
  hideEditPopup()
}

const showAvatarPopup = () => {
  showAvatarSelect.value = true
  selectedAvatar.value = userInfo.value.avatar || ''
}

const hideAvatarPopup = () => {
  showAvatarSelect.value = false
}

const selectAvatar = (url: string) => {
  selectedAvatar.value = url
}

const confirmAvatarChange = async () => {
  if (!selectedAvatar.value) {
    uni.showToast({ title: '请选择头像', icon: 'none' })
    return
  }
  userInfo.value.avatar = selectedAvatar.value
  await updateUser({ id: userInfo.value.id, avatar: selectedAvatar.value })
  uni.showToast({ title: '头像更新成功', icon: 'success' })
  hideAvatarPopup()
}

const handleLogout = () => {
  uni.showModal({
    title: '提示',
    content: '确定退出登录？',
    success: res => {
      if (res.confirm) {
		setUserInfo(null)
		logout()
      }
    }
  })
}

onMounted(() => {
  loadUser()
})
</script>

<style scoped>
