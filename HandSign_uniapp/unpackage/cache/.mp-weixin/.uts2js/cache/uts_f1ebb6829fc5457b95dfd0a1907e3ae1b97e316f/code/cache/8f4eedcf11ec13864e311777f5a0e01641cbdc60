{"code":"import {} from \"@/common/request\";\n// ======================\n// 🔥 统一配置接口地址 (只需要改这里)\n// ======================\nconst API_BASE = 'https://springboot.fanzengxie.icu';\n// 上传图片\nconst UPLOAD_IMAGE_URL = `${API_BASE}/files/upload`;\n// 富文本编辑器上传\nconst EDITOR_UPLOAD_URL = `${API_BASE}/files/editor/upload`;\n// 文件下载前缀\nconst FILE_DOWNLOAD_PREFIX = `${API_BASE}/files`;\n/**\n * 上传图片到服务器\n * @param filePath 本地图片临时路径\n * @returns 服务器返回的图片URL\n */\nexport function uploadImage(filePath) {\n    return new Promise((resolve, reject) => {\n        uni.uploadFile({\n            url: UPLOAD_IMAGE_URL,\n            filePath: filePath,\n            name: 'file',\n            header: new UTSJSONObject({\n                'Accept': 'application/json'\n            }),\n            success: (res) => {\n                try {\n                    const data = UTS.JSON.parse(res.data);\n                    if (data.code === '200' || data.code === 200) {\n                        resolve(data);\n                    }\n                    else {\n                        reject(new Error(`上传失败：${data.msg || '接口返回错误'}`));\n                    }\n                }\n                catch (err) {\n                    reject(new Error(`解析失败：${err.message}`));\n                }\n            },\n            fail: (err) => {\n                reject(new Error(`网络异常：${err.errMsg}`));\n            }\n        });\n    });\n}\n/**\n * 下载并打开文件\n * @param flag 文件标识\n */\nexport function downloadFile(flag) {\n    uni.downloadFile({\n        url: `${FILE_DOWNLOAD_PREFIX}/${flag}`,\n        success: (res) => {\n            if (res.statusCode === 200) {\n                uni.openDocument({\n                    filePath: res.tempFilePath,\n                    success: () => {\n                        uni.showToast({ title: '文件打开成功', icon: 'success' });\n                    },\n                    fail: (err) => {\n                        uni.showToast({ title: `打开失败：${err.errMsg}`, icon: 'none' });\n                    }\n                });\n            }\n        },\n        fail: (err) => {\n            uni.showToast({ title: `下载失败：${err.errMsg}`, icon: 'none' });\n        }\n    });\n}\n/**\n * 富文本编辑器图片上传\n * @param filePath 本地图片路径\n * @returns 富文本格式结果\n */\nexport function editorUploadImage(filePath) {\n    return new Promise((resolve, reject) => {\n        uni.uploadFile({\n            url: EDITOR_UPLOAD_URL,\n            filePath: filePath,\n            name: 'file',\n            header: new UTSJSONObject({\n                'Accept': 'application/json'\n            }),\n            success: (res) => {\n                try {\n                    const data = UTS.JSON.parse(res.data);\n                    resolve(data);\n                }\n                catch (err) {\n                    reject(new Error(`解析失败：${err.message}`));\n                }\n            },\n            fail: (err) => {\n                reject(new Error(`上传失败：${err.errMsg}`));\n            }\n        });\n    });\n}\n//# sourceMappingURL=E:/Handsign/Web/HandSign_uniapp/api/file.uts.js.map","references":[],"uniExtApis":["uni.uploadFile","uni.downloadFile","uni.openDocument","uni.showToast"],"map":"{\"version\":3,\"file\":\"file.uts.js\",\"sourceRoot\":\"\",\"sources\":[\"file.uts\"],\"names\":[],\"mappings\":\"AAAA,OAAY,EAAa,yBAA6B;AAEtD,yBAAyB;AACzB,uBAAuB;AACvB,yBAAyB;AACzB,MAAM,QAAQ,GAAG,mCAAmC,CAAC;AAErD,OAAO;AACP,MAAM,gBAAgB,GAAG,GAAG,QAAQ,eAAe,CAAC;AACpD,WAAW;AACX,MAAM,iBAAiB,GAAG,GAAG,QAAQ,sBAAsB,CAAC;AAC5D,SAAS;AACT,MAAM,oBAAoB,GAAG,GAAG,QAAQ,QAAQ,CAAC;AAEjD;;;;GAIG;AACH,MAAM,UAAU,WAAW,CAAC,QAAgB;IAC1C,OAAO,IAAI,OAAO,CAAC,CAAC,OAAO,EAAE,MAAM;QACjC,GAAG,CAAC,UAAU,CAAC;YACb,GAAG,EAAE,gBAAgB;YACrB,QAAQ,EAAE,QAAQ;YAClB,IAAI,EAAE,MAAM;YACZ,MAAM,oBAAE;gBACN,QAAQ,EAAE,kBAAkB;aAC7B,CAAA;YACD,OAAO,EAAE,CAAC,GAAG;gBACX,IAAI;oBACF,MAAM,IAAI,GAAG,SAAK,KAAK,CAAC,GAAG,CAAC,IAAI,CAAC,CAAC;oBAClC,IAAI,IAAI,CAAC,IAAI,KAAK,KAAK,IAAI,IAAI,CAAC,IAAI,KAAK,GAAG,EAAE;wBAC5C,OAAO,CAAC,IAAI,CAAC,CAAC;