  width: 100%;
  height: 100vh;
  position: relative;
  overflow: hidden;
}

.bg-layer {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.bg-img {
  width: 100%;
  height: 100%;
  opacity: 0.2;
}

.mask {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.9) 0%, rgba(255, 255, 255, 0.85) 100%);
}

.content-wrapper {
  position: relative;
  z-index: 1;
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 0 40rpx;
  box-sizing: border-box;
  background-image:  url('https://free.picui.cn/free/2026/03/08/69ad28f585a3f.png');
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
}

.title-box {
  text-align: center;
  margin-bottom: 60rpx;
}

.main-title {
  font-size: 48rpx;
  font-weight: bold;
  color: #2c3e50;
  display: block;
  margin-bottom: 16rpx;
}

.sub-title {
  font-size: 24rpx;
  color: #7f8c8d;
  font-family: 'Arial', sans-serif;
  display: block;
}

.register-container {
  background: #ffffff;
  padding: 60rpx 40rpx;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.08);
  opacity: 0.75;
}

.form-item {
  margin-bottom: 30rpx;
}

.input-wrapper {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: flex-start;
  height: 98rpx;
  padding: 0 24rpx;
  border: 2rpx solid #e8f4f8;
  border-radius: 16rpx;
  background-color: #f8f9fa;
  transition: all 0.3s ease;
  box-sizing: border-box;
}

.input-wrapper.error-border {
  border-color: #ff3b30;
}

.input-wrapper:focus-within {
  border-color: #3498db;
  box-shadow: 0 0 0 6rpx rgba(52, 152, 219, 0.1);
}

.input-icon {
  font-size: 32rpx;
  color: #95a5a6;
  margin-right: 20rpx;
  line-height: 1;
  flex-shrink: 0; 
  padding: 5rpx;
}

.input-box {
  flex: 1;
  height: 100%;
  font-size: 32rpx;
  color: #2c3e50;
  background: transparent;
  border: none;
  padding: 0;
  margin: 0;
  box-sizing: border-box;
}

.input-box::placeholder {
  color: #bdc3c7;
  font-size: 30rpx;
}

.error-text {
  font-size: 24rpx;
  color: #ff3b30;
  margin-top: 12rpx;
  display: block;
  padding-left: 10rpx;
  line-height: 1.4;
}

.register-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background: linear-gradient(90deg, #3498db, #2980b9);
  color: #ffffff;
  border-radius: 16rpx;
  border: none;
  font-size: 34rpx;
  font-weight: 600;
  margin-top: 20rpx;
  box-shadow: 0 6rpx 16rpx rgba(52, 152, 219, 0.3);
  transition: all 0.3s ease;
}

.register-btn:disabled {
  background: linear-gradient(90deg, #95a5a6, #7f8c8d);
  box-shadow: none;
  transform: none !important;
}

.register-btn:active:not(:disabled) {
  transform: scale(0.98);
  box-shadow: 0 3rpx 8rpx rgba(52, 152, 219, 0.2);
}

.link-box {
  text-align: center;
  margin-top: 40rpx;
}

.login-link {
  font-size: 28rpx;
  color: #3498db;
  text-decoration: underline;
  text-underline-offset: 4rpx;
}

.login-link:active {
  color: #2980b9;
}

.captcha-wrapper {
  padding-right: 15rpx;
}

.captcha-input {
  flex: none;
  width: 50%;
}

.captcha-img {
  width: 140rpx;
  height: 70rpx;
  border-radius: 8rpx;
  margin-left: 10rpx;
  flex-shrink: 0;
}

.refresh-icon {
  font-size: 24rpx;
  color: #3498db;
  margin-left: 8rpx;
  padding: 8rpx;
  flex-shrink: 0;
}
</style>