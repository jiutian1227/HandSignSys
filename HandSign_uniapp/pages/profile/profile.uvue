.action-item{
  display:flex;
  flex-direction:column;
  align-items:center;
  padding:40rpx 20rpx;
  background:#f8f9ff;
  border-radius:20rpx;
  opacity:0.95; /* 操作项透明度 */
}
.action-item:active{transform:scale(0.95);background:#e8f4ff}
.action-icon{
  font-size:50rpx;
  margin-bottom:20rpx;
  opacity:0.9; /* 操作项图标透明度 */
}
.action-text{
  font-size:26rpx;
  color:#333;
  opacity:0.95; /* 操作项文字透明度 */
}
